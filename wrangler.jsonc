{
  // Cloudflare Workers 配置
  // 关键点：r2_buckets 里【故意不写 bucket_name】，部署时 Cloudflare 会自动创建
  // 并以 worker 的 name 作为前缀命名，同时自动绑定到 MY_BUCKET。
  // 详见 README.md 的「自动创建 R2」一节。
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cloud-notepad",
  "main": "src/index.js",
  "compatibility_date": "2026-10-10",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "upload_source_maps": true,
  "r2_buckets": [
    {
      "binding": "MY_BUCKET"
    }
  ],
  // 把 src/views/*.html 当作「文本模块」导入，前端整页 HTML 就不必塞进 JS 模板字符串里，
  // 从根本上规避模板字符串的反引号 / 正则转义坑。
  "rules": [
    {
      "type": "Text",
      "globs": ["**/*.html"],
      "fallthrough": true
    }
  ]
  // 可选：想用 Turnstile 又不想在应用内设置页里填，可以取消下面两行注释。
  // 注意：secret 属于敏感信息，更推荐用 `npx wrangler secret put TURNSTILE_SECRET_KEY`。
  // 应用内设置页的优先级高于这里的环境变量。
  // "vars": { "TURNSTILE_SITE_KEY": "", "TURNSTILE_SECRET_KEY": "" }
}
